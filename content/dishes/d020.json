  "steps": [
    { "index": 1, "description": "鸡肉剁成指尖大小的块，加生抽、料酒抓匀腌 10 分钟；青线椒、小米辣切圈，姜蒜切末。" },
    { "index": 2, "description": "锅烧到微微冒烟，倒油下鸡块大火快炒，炒到鸡块收紧、边缘微焦，盛出。" },
    { "index": 3, "description": "底油爆香姜蒜末，下青线椒、小米辣翻炒出辣味。" },
    { "index": 4, "description": "倒回鸡块，加老抽、糖、盐大火翻匀，炒到酱汁收干裹满鸡块即可出锅。" }
