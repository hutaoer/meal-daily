  "steps": [
    { "index": 1, "description": "牛肉逆纹切丝，加生抽、淀粉、少许油抓匀封浆，腌 10 分钟；芦笋去老根切斜段。" },
    { "index": 2, "description": "烧一锅开水，芦笋烫 30 秒捞出过凉，沥干备用。" },
    { "index": 3, "description": "热锅凉油下牛肉丝大火滑散，炒到变色立即盛出。" },
    { "index": 4, "description": "底油爆香蒜末，下芦笋翻炒，倒回牛肉丝，加盐、糖大火翻匀即可出锅。" }
