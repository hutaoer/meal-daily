  "story": [
    "这碗面没有菜谱可言，纯粹是冰箱里只剩一把青菜和两个鸡蛋时的产物。但越是这种时候，端上桌的那一碗越让人踏实。",
    "关键只有两处：汤底先用一点生抽和猪油（或香油）冲开，面条别煮太烂。蛋要最后卧，焖到蛋白刚好凝住、蛋黄还是软的。"
  ],
  "ingredients": [
    { "name": "细面条", "amount": "1 把" },
    { "name": "鸡蛋", "amount": "1 个" },
    { "name": "小青菜", "amount": "1 小把" },
    { "name": "生抽", "amount": "1 勺" },
    { "name": "香油 / 白胡椒", "amount": "少许" }
  ],
  "steps": [
    { "index": 1, "description": "碗里放生抽、香油、少许白胡椒，冲入半碗开水做汤底。" },
    { "index": 2, "description": "另起锅煮面，面条快熟时放入小青菜烫软，一起捞进汤底。" },
    { "index": 3, "description": "锅里卧一个鸡蛋，小火焖到蛋白凝固，连汤一起倒进碗中即可。" }
  ],
