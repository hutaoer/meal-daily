  "story": [
    "好吃的牛肉面，灵魂全在那锅红烧牛肉汤里。牛腩炖到软烂，汤色红亮、香气逼人，煮一把筋道的面条，连汤带肉浇上去，撒一把香菜，一碗下肚浑身舒坦。",
    "小技巧：牛腩要冷水下锅焯水去血沫，炒糖色时别糊，加开水炖汤色才不浑；至少炖一个小时，肉才会入口即化；面条另起锅煮好再浇汤，汤头才不被稀释。"
  ],
  "ingredients": [
    { "name": "牛腩", "amount": "500 g" },
    { "name": "面条", "amount": "2 人份" },
    { "name": "姜 / 葱 / 蒜", "amount": "适量" },
    { "name": "八角 / 桂皮 / 香叶", "amount": "各少许" },
    { "name": "生抽 / 老抽", "amount": "各 1 勺" },
    { "name": "豆瓣酱 / 番茄酱", "amount": "各 1 勺" },
    { "name": "糖 / 盐", "amount": "少许" },
    { "name": "香菜", "amount": "1 把" }
  ],
  "steps": [
    { "index": 1, "description": "牛腩切块，冷水下锅加姜片、料酒焯水，捞出洗净。" },
    { "index": 2, "description": "锅里炒糖色，下牛腩翻炒上色，加姜蒜、香料、豆瓣酱、番茄酱炒香。" },
    { "index": 3, "description": "加没过牛肉的开水，放生抽、老抽、糖，大火烧开转小火炖 1 小时至软烂，加盐调味。" },
    { "index": 4, "description": "另起锅煮面，面熟捞入碗中，浇上牛肉和红汤，撒香菜即可。" }
