  "steps": [
    { "index": 1, "description": "大虾剪须开背去虾线，鲍鱼去壳片薄片，秋葵洗净整根备用。" },
    { "index": 2, "description": "锅里烧水，加姜片和料酒，水开后先下秋葵烫 2 分钟，捞出过凉。" },
