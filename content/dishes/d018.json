    { "name": "盐 / 糖", "amount": "少许" }
  ],
  "steps": [
    { "index": 1, "description": "牛肉逆纹切细丝，加生抽、料酒、淀粉抓匀，再淋一勺油封浆，腌 10 分钟。" },
    { "index": 2, "description": "泡姜、泡椒切丝，芹菜切段，蒜切片。" },
    { "index": 3, "description": "热锅宽油，下牛肉丝大火滑散到刚变色，立刻盛出。" },
