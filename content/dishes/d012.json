  "story": [
    "回锅肉是冰箱里有点肥肉时最该做的菜。先把整块五花煮熟，放凉了切薄片，下锅才能煸出卷边的灯盏窝。",
    "蒜苗别炒太狠，断生就好，借一点肉里的油最香。"
  ],
  "ingredients": [
    { "name": "带皮五花肉", "amount": "300 g" },
    { "name": "青蒜苗", "amount": "1 把" },
    { "name": "郫县豆瓣酱", "amount": "1 勺" },
    { "name": "甜面酱", "amount": "半勺" },
    { "name": "生抽", "amount": "1 勺" },
    { "name": "姜片", "amount": "几片" }
  ],
  "steps": [
    { "index": 1, "description": "五花肉冷水下锅煮到筷子能扎透，捞出放凉切薄片。" },
    { "index": 2, "description": "中火少油下肉片，煸到卷边、吐出油，盛出多余的油。" },
    { "index": 3, "description": "下豆瓣酱和姜片炒出红油，放肉片、甜面酱、生抽翻炒。" },
    { "index": 4, "description": "最后下蒜苗段大火翻匀，蒜苗一塌就出锅。" }
