  "story": [
    "干菜蒸五花肉是梅菜扣肉的家常简化版，不用炸、不用扣，五花肉煸出油，和泡发的干菜一层一层码好上锅蒸，肉的油渗进干菜，干菜的咸香又回润到肉里。",
    "小技巧：五花肉先下锅煸出多余油脂，吃起来才不腻；干菜要提前泡软洗去泥沙，蒸的时间够长（至少 40 分钟）肉才会软糯，出锅前撒一把葱花。"
  ],
  "ingredients": [
    { "name": "五花肉", "amount": "400 g" },
    { "name": "梅干菜 / 干菜", "amount": "1 把" },
    { "name": "姜 / 蒜", "amount": "适量" },
    { "name": "生抽 / 老抽", "amount": "各 1 勺" },
    { "name": "料酒", "amount": "1 勺" },
    { "name": "糖 / 盐", "amount": "少许" },
    { "name": "葱花", "amount": "少许" }
  ],
  "steps": [
    { "index": 1, "description": "干菜提前泡软，反复洗去泥沙，挤干切碎；五花肉切薄片。" },
    { "index": 2, "description": "五花肉下锅小火煸出油脂，加姜蒜、生抽、老抽、料酒、糖翻炒上色。" },
    { "index": 3, "description": "碗底铺一层煸好的五花肉，上面铺满干菜，再淋少许炒肉的汤汁。" },
    { "index": 4, "description": "上锅大火蒸 40 分钟至肉软糯，倒扣到盘里，撒葱花即可。" }
